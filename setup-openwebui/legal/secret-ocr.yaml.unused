apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: aws-cred-secret
  namespace: legal-webui
spec:
  refreshInterval: "15m"
  secretStoreRef:
    name: aws-secretsmanager
    kind: ClusterSecretStore
  target:
    name: bda-access-credentials
    creationPolicy: Owner
  data:
  - secretKey: username
    remoteRef:
      key: "automode-cluster-postgres-credentials-legal-20250624024807161400000019"
      property: username
  - secretKey: password
    remoteRef:
      key: "automode-cluster-postgres-credentials-legal-20250624024807161400000019"
      property: password
