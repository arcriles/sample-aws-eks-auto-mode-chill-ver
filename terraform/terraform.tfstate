    {
      "mode": "managed",
      "type": "local_file",
      "name": "setup_litellm_configmap",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: litellm-config\n  namespace: litellm\ndata:\n  config.yaml: |\n    model_list:\n      # LiteLLM Model Configuration\n      # Add your models here. Each model needs a name and configuration.\n      # For Azure models, use environment variables for API keys (e.g., os.environ/AZURE_GPT_4O_API_KEY)\n\n      # Example: Local vLLM model (already running in the cluster)\n      #- model_name: deepseek\n      #  litellm_params:\n      #    model: openai/deepseek-ai/DeepSeek-R1-Distill-Qwen-32B\n      #    api_base: \"http://vllm-service.vllm-inference.svc.cluster.local:80/v1\"\n      #    api_key: os.environ/DUMMY_API_KEY\n      #    num_retries: 3\n\n      # Example: Azure OpenAI Models\n      # Uncomment and configure these after setting up your API keys\n\n       - model_name: gpt-4o\n         litellm_params:\n           model: azure/gpt-4o\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2025-01-01-preview\"\n           api_key: os.environ/AZURE_GPT_4O_API_KEY\n\n       - model_name: gpt-4.1\n         litellm_params:\n           model: azure/gpt-4.1\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2025-01-01-preview\"\n           api_key: os.environ/AZURE_GPT_41_API_KEY\n\n       - model_name: gpt-4o-mini\n         litellm_params:\n           model: azure/gpt-4o-mini\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2025-01-01-preview\"\n           api_key: os.environ/AZURE_GPT_4O_MINI_API_KEY\n\n       - model_name: text-embedding-3-large\n         litellm_params:\n           model: azure/text-embedding-3-large\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2023-05-15\"\n           api_key: os.environ/AZURE_TEXT_EMBEDDING_3_LARGE_API_KEY\n\n       - model_name: text-embedding-3-small\n         litellm_params:\n           model: azure/text-embedding-3-small\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2023-05-15\"\n           api_key: os.environ/AZURE_TEXT_EMBEDDING_3_SMALL_API_KEY\n\n       - model_name: whisper\n         litellm_params:\n           model: azure/whisper\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2024-06-01\"\n           api_key: os.environ/AZURE_WHISPER_API_KEY\n\n       - model_name: gpt-4o-mini-transcribe\n         litellm_params:\n           model: azure/gpt-4o-mini-transcribe\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2025-03-01-preview\"\n           api_key: os.environ/AZURE_GPT_4O_MINI_TRANSCRIBE_API_KEY\n\n       - model_name: gpt-4o-transcribe\n         litellm_params:\n           model: azure/gpt-4o-transcribe\n           api_base: https://openai-q2ifd2wgmoexo.openai.azure.com\n           api_version: \"2025-03-01-preview\"\n           api_key: os.environ/AZURE_GPT_4O_TRANSCRIBE_API_KEY\n\n       - model_name: gpt-image-1\n         litellm_params:\n           model: azure/gpt-image-1\n           api_base: https://openai-itdd.openai.azure.com\n           api_version: \"2025-04-01-preview\"\n           api_key: os.environ/AZURE_GPT_IMAGE_1_API_KEY\n\n       - model_name: dall-e-3\n         litellm_params:\n           model: azure/dall-e-3\n           api_base: https://aulia-m3odnaiy-eastus.cognitiveservices.azure.com\n           api_version: \"2024-02-01\"\n           api_key: os.environ/AZURE_DALL_E_3_API_KEY\n\n      # Example: Azure AI Models\n\n       - model_name: Llama-3-2-90B-Vision-GAR\n         litellm_params:\n           model: azure_ai/Llama-3.2-90B-Vision-Instruct\n           api_base: https://Llama-3-2-90B-Vision-GAR.southcentralus.models.ai.azure.com\n           api_key: os.environ/AZURE_AI_LLAMA_3_2_90B_VISION_API_KEY\n\n       - model_name: DeepSeek-R1-GAR\n         litellm_params:\n           model: azure_ai/deepseek-r1\n           api_base: https://DeepSeek-R1-GAR.southcentralus.models.ai.azure.com\n           api_key: os.environ/AZURE_AI_DEEPSEEK_R1_API_KEY\n\n       - model_name: MAI-DS-R1\n         litellm_params:\n           model: azure_ai/MAI-DS-R1\n           api_base: https://MAI-DS-R1.southcentralus.models.ai.azure.com\n           api_key: os.environ/AZURE_AI_MAI_DS_R1_API_KEY\n\n       - model_name: DeepSeek-V3-0324-GAR\n         litellm_params:\n           model: azure_ai/deepseek-v3-0324\n           api_base: https://DeepSeek-V3-0324-GAR.southcentralus.models.ai.azure.com\n           api_key: os.environ/AZURE_AI_DEEPSEEK_V3_0324_API_KEY\n\n       - model_name: Phi-4-multimodal-instruct\n         litellm_params:\n           model: azure_ai/Phi-4-multimodal-instruct\n           api_base: https://Phi-4-multimodal-instruct.southcentralus.models.ai.azure.com\n           api_key: os.environ/AZURE_AI_PHI_4_MULTIMODAL_API_KEY\n           max_tokens: 4096\n           temperature: 0.1\n\n\n    litellm_settings:\n      cache: false\n\n    general_settings:\n      # master_key and database_url will be set via environment variables\n      disable_spend_logs: false\n      disable_usage_tracking: false\n      disable_telemetry: true\n      routing_strategy: \"simple-shuffle\"\n      num_retries: 3\n      allowed_origins: [\"*\"]\n",
            "content_base64": null,
            "content_base64sha256": "G63BTGhdfny8olIUYE2D5IwQfWJt/iZ0DSrM+EbCm5c=",
            "content_base64sha512": "oj/jMIL2j7nttHAGgj1/avTAHo5o7a1Y2HbNgAk6nd4qYqWejlzPwJbr92BLSy0YN89WzRfmFZRP4UDFsWV3vg==",
            "content_md5": "f80afa09ca5c5d17e33838ad6297bd87",
