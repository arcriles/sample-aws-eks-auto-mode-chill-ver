      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "---\napiVersion: eks.amazonaws.com/v1\nkind: NodeClass\nmetadata:\n  name: spot-nodeclass\nspec:\n  role: automode-cluster-eks-auto-20250523080440398700000006\n  subnetSelectorTerms:\n    - tags:\n        karpenter.sh/discovery: \"automode-demo\"\n  securityGroupSelectorTerms:\n    - tags:\n        aws:eks:cluster-name: automode-cluster\n  tags:\n    karpenter.sh/discovery: \"automode-demo\"\n---\napiVersion: karpenter.sh/v1\nkind: NodePool\nmetadata:\n  name: spot-nodepool\nspec:\n  template:\n    spec:\n      nodeClassRef:\n        group: eks.amazonaws.com\n        kind: NodeClass\n        name: spot-nodeclass\n      requirements:\n        - key: \"eks.amazonaws.com/instance-category\"\n          operator: In\n          values: [\"c\", \"m\", \"r\"]\n        - key: \"eks.amazonaws.com/instance-cpu\"\n          operator: In\n          values: [\"4\", \"8\", \"16\", \"32\"]\n        - key: \"kubernetes.io/arch\"\n          operator: In\n          values: [\"arm64\"]\n        - key: \"karpenter.sh/capacity-type\"\n          operator: In\n          values: [\"spot\"]\n      taints:\n        - key: \"spot\"\n          value: \"true\"\n          effect: \"NoSchedule\"\n  limits:\n    cpu: 1000\n  disruption:\n    consolidationPolicy: WhenEmpty\n    consolidateAfter: 30s\n",
            "content_base64": null,
