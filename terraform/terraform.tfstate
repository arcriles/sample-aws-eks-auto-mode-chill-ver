            "content": "---\napiVersion: eks.amazonaws.com/v1\nkind: NodeClass\nmetadata:\n  name: graviton-nodeclass\nspec:\n  role: automode-cluster-eks-auto-20250620021813445700000005\n  subnetSelectorTerms:\n    - tags:\n        karpenter.sh/discovery: \"automode-demo\"\n  securityGroupSelectorTerms:\n    - tags:\n        aws:eks:cluster-name: automode-cluster\n  tags:\n    karpenter.sh/discovery: \"automode-demo\"\n---\napiVersion: karpenter.sh/v1\nkind: NodePool\nmetadata:\n  name: graviton-nodepool\nspec:\n  template:\n    spec:\n      nodeClassRef:\n        group: eks.amazonaws.com\n        kind: NodeClass\n        name: graviton-nodeclass\n      requirements:\n        - key: \"eks.amazonaws.com/instance-category\"\n          operator: In\n          values: [\"c\", \"m\", \"r\"]\n        - key: \"eks.amazonaws.com/instance-cpu\"\n          operator: In\n          values: [\"4\", \"8\", \"16\", \"32\"]\n        - key: \"kubernetes.io/arch\"\n          operator: In\n          values: [\"arm64\"]\n      taints:\n        - key: \"arm64\"\n          value: \"true\"\n          effect: \"NoSchedule\"\n  limits:\n    cpu: 1000\n  disruption:\n    consolidationPolicy: WhenEmpty\n    consolidateAfter: 30s\n",
